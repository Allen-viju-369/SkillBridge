# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Provide your local or Atlas MongoDB URI. If local MongoDB is not running,
# setting USE_EMBEDDED_DB_FALLBACK=true will automatically launch an in-memory/embedded MongoDB engine.
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
USE_EMBEDDED_DB_FALLBACK=true

# Session Security
SESSION_SECRET=skillbridge_super_secret_session_key_2026_change_in_production

# Initial Administrator Account Setup (via: npm run create-admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
