<!-- Hero Section -->
<section class="hero-section text-center text-lg-start mb-5 shadow-sm">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="badge px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; font-size: 0.82rem;">
          <i class="bi bi-mortarboard-fill"></i> University Freelance Ecosystem
        </span>
        <h1 class="hero-title mb-3">
          Empowering University<br>
          Talent. Commission<br>
          <span class="hero-gradient-text">Real Projects.</span>
        </h1>
        <p class="hero-subtitle mb-4 text-secondary">
          SkillBridge is the premier campus-driven freelance marketplace connecting capable university students with clients, faculty research labs, and startups.
        </p>

        <!-- Prominent Search Bar Form -->
        <form action="/marketplace" method="GET" class="p-2 hero-search-bar rounded-pill shadow-lg border d-flex align-items-center gap-2 mb-4" style="max-width: 540px;">
          <span class="ps-3 text-muted"><i class="bi bi-search fs-5"></i></span>
          <input type="text" name="q" class="form-control border-0 shadow-none ps-2 text-white" placeholder="Search web dev, Figma, Python, content writing..." aria-label="Search services">
          <button type="submit" class="btn rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 44px; height: 44px; background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%); border: none;" title="Search">
            <i class="bi bi-arrow-right text-white fs-5"></i>
          </button>
        </form>

        <!-- Quick Tags -->
        <div class="d-flex flex-wrap align-items-center gap-2">
          <a href="/marketplace?q=Node.js" class="badge-pill-tag badge-node text-decoration-none">
            <i class="bi bi-code-slash"></i> Node.js
          </a>
          <a href="/marketplace?q=Figma" class="badge-pill-tag badge-figma text-decoration-none">
            <i class="bi bi-palette-fill"></i> Figma UI/UX
          </a>
          <a href="/marketplace?q=Python" class="badge-pill-tag badge-python text-decoration-none">
            <i class="bi bi-filetype-py"></i> Python
          </a>
          <a href="/marketplace?q=React" class="badge-pill-tag badge-react text-decoration-none">
            <i class="bi bi-lightning-charge-fill"></i> React
          </a>
        </div>
      </div>

      <!-- Hero Visual Showcase Column -->
      <div class="col-lg-5">
        <!-- Floating Glassmorphic Student Skill Passport Card -->
        <div class="passport-card-glass mb-3">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0 text-white">Student Skill Passport</h5>
            <span class="badge px-3 py-1 rounded-pill small fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #2563eb); font-size: 0.75rem;">
              <i class="bi bi-patch-check-fill me-1"></i> VERIFIED
            </span>
          </div>

          <!-- Featured Student Showcase Snapshot -->
          <div class="p-3 passport-inner-card rounded-4 border shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="d-flex align-items-center gap-3">
                <span class="user-avatar-badge shadow-sm" style="width: 46px; height: 46px; font-size: 1.25rem;">S</span>
                <div>
                  <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">Student Freelancer Profile</h6>
                  <span class="text-muted small" style="font-size: 0.75rem;"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Campus Verified</span>
                </div>
              </div>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small fw-semibold">
                <i class="bi bi-check-circle-fill me-1"></i> Available
              </span>
            </div>
            
            <div class="d-flex flex-wrap gap-1 mb-2">
              <span class="badge bg-success text-white rounded-pill px-2 py-1 small fw-semibold">Node.js</span>
              <span class="badge rounded-pill px-2 py-1 small fw-semibold text-white" style="background: #ec4899;">Figma</span>
              <span class="badge rounded-pill px-2 py-1 small fw-semibold text-white" style="background: #9333ea;">Figma UI/UX</span>
              <span class="badge rounded-pill px-2 py-1 small fw-semibold text-white" style="background: #f97316;">Python</span>
              <span class="badge rounded-pill px-2 py-1 small fw-semibold text-white" style="background: #06b6d4;">React</span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted" style="font-size: 0.75rem;">
              <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Fast Delivery</span>
              <span class="fw-semibold text-white"><i class="bi bi-shield-check text-success me-1"></i>Verified Academic Reviews</span>
            </div>
          </div>
        </div>

        <!-- 3 Eye-Catching Colored Stat Cards (Purple, Green, Blue) -->
        <div class="row g-2">
          <div class="col-4">
            <div class="stat-card stat-purple p-3 text-center text-white">
              <div class="fs-2 fw-bold counter-val" data-target="<%= stats.totalStudents || 3 %>"><%= stats.totalStudents || 3 %></div>
              <div class="small fw-semibold opacity-90" style="font-size: 0.72rem; line-height: 1.2;">Registered<br>Students</div>
            </div>
          </div>
          <div class="col-4">
            <div class="stat-card stat-green p-3 text-center text-white">
              <div class="fs-2 fw-bold counter-val" data-target="<%= stats.completedOrders || 1 %>"><%= stats.completedOrders || 1 %></div>
              <div class="small fw-semibold opacity-90" style="font-size: 0.72rem; line-height: 1.2;">Completed<br>Projects</div>
            </div>
          </div>
          <div class="col-4">
            <div class="stat-card stat-blue p-3 text-center text-white">
              <div class="fs-2 fw-bold"><%= stats.platformAvgRating || '3.0' %> <i class="bi bi-star-fill text-warning fs-5"></i></div>
              <div class="small fw-semibold opacity-90" style="font-size: 0.72rem; line-height: 1.2;">Client<br>Rating</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

