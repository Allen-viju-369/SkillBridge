<!-- Featured Freelance Services -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Handpicked Solutions</h6>
      <h2 class="fw-bold mb-0">Featured Student Services</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">Browse Marketplace <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <% if (featuredServices && featuredServices.length > 0) { %>
    <div class="row g-4">
      <% featuredServices.forEach(service => { %>
        <div class="col-lg-4 col-md-6">
          <div class="anti-gravity-service-card h-100">
            <!-- 1. Top Hierarchy: Grouped Badge & Delivery Time (justify-between) -->
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge px-3 py-2 rounded-pill fw-semibold small" style="background: rgba(59, 130, 246, 0.1); color: #2563eb; border: 1px solid rgba(59, 130, 246, 0.2);">
                <i class="bi <%= service.category ? service.category.icon : 'bi-code-slash' %> me-1"></i><%= service.category ? service.category.name : 'Web Development' %>
              </span>
              <span class="small text-muted d-inline-flex align-items-center" style="font-size: 0.85rem;">
                <i class="bi bi-clock me-1 text-secondary"></i><%= service.deliveryDays %> Days
              </span>
            </div>

            <!-- 2. Middle Hierarchy: Heading, Description, Skills -->
            <h5 class="fw-bold mb-2">
              <a href="/marketplace/<%= service._id %>" class="text-decoration-none text-white stretched-link">
                <%= service.title %>
              </a>
            </h5>

            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
              <%= service.description %>
            </p>

            <% if (service.skills && service.skills.length > 0) { %>
              <div class="d-flex flex-wrap gap-1 mb-2">
                <% service.skills.slice(0, 3).forEach(skill => { %>
                  <span class="badge-skill" style="font-size: 0.72rem;"><%= skill %></span>
                <% }) %>
              </div>
            <% } %>

            <!-- 3. Subtle Dividing Line -->
            <hr class="my-3 border-0" style="height: 1px; background-color: rgba(255, 255, 255, 0.1);">

            <!-- 4. Bottom Anchored: Upgraded Gradient Avatar & Price -->
            <div class="d-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
              <% if (service.freelancer) { %>
                <a href="/freelancers/<%= service.freelancer._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-white">
                  <span class="avatar-gradient-pill"><%= (service.freelancer.name || 'G').charAt(0).toUpperCase() %></span>
                  <div>
                    <span class="fw-bold small d-block lh-1 text-white"><%= service.freelancer.name %></span>
                    <% if (service.freelancer.isVerified) { %>
                      <span class="text-primary small" style="font-size: 0.68rem;"><i class="bi bi-patch-check-fill"></i> Verified</span>
                    <% } %>
                  </div>
                </a>
              <% } else { %>
                <div class="d-flex align-items-center gap-2">
                  <span class="avatar-gradient-pill">G</span>
                  <span class="small fw-bold text-white">Student Freelancer</span>
                </div>
              <% } %>

              <div class="text-end">
                <span class="text-muted small d-block" style="font-size: 0.72rem;">Starting at</span>
                <span class="fw-bold fs-5 text-primary"><%= formatCurrency(service.price) %></span>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
      <i class="bi bi-briefcase fs-1 text-muted mb-3 d-block"></i>
      <h5 class="fw-bold mb-1">No services yet. Be the first to post one!</h5>
      <p class="text-muted small mb-3">Join as a student freelancer and publish your freelance packages to get hired.</p>
      <% if (isStudent) { %>
        <a href="/services/create" class="btn btn-primary-custom btn-sm"><i class="bi bi-plus-lg me-1"></i>Post a Service</a>
      <% } else { %>
        <a href="/auth/register?role=student" class="btn btn-primary-custom btn-sm"><i class="bi bi-person-plus me-1"></i>Become a Student Freelancer</a>
      <% } %>
    </div>
  <% } %>
</section>

<!-- Featured Student Freelancers Section -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Campus Creators</h6>
      <h2 class="fw-bold mb-0">Featured Student Freelancers</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">Discover All <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <% if (topFreelancers && topFreelancers.length > 0) { %>
    <div class="row g-4">
      <% topFreelancers.forEach(fl => { %>
        <div class="col-md-6 col-lg-3">
          <div class="custom-card p-3 h-100 text-center d-flex flex-column align-items-center">
            <span class="user-avatar-badge mb-3 shadow" style="width: 58px; height: 58px; font-size: 1.4rem;"><%= (fl.name || 'S').charAt(0).toUpperCase() %></span>
            <h6 class="fw-bold mb-0">
              <%= fl.name %>
              <% if (fl.isVerified) { %><i class="bi bi-patch-check-fill text-primary" title="Verified"></i><% } %>
            </h6>
            <small class="text-muted mb-2 d-block text-truncate" style="max-width: 180px;"><%= fl.college || 'Student Freelancer' %></small>
            <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
              <% (fl.skills || []).slice(0, 3).forEach(s => { %>
                <span class="badge-skill" style="font-size: 0.7rem;"><%= s %></span>
              <% }) %>
            </div>
            <a href="/freelancers/<%= fl._id %>" class="btn btn-outline-custom btn-sm mt-auto w-100">View Skill Passport</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-4 bg-white rounded-4 border">
      <i class="bi bi-people fs-2 text-muted mb-2 d-block"></i>
      <h6 class="fw-bold mb-1">No student freelancers registered yet.</h6>
      <p class="text-muted small mb-3">Be the first to build your Student Skill Passport and showcase your talent.</p>
      <a href="/auth/register?role=student" class="btn btn-primary-custom btn-sm"><i class="bi bi-person-plus me-1"></i>Register as Student Freelancer</a>
    </div>
  <% } %>
</section>

