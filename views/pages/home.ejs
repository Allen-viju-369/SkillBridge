<!-- Hero Section -->
<section class="hero-section text-center text-lg-start mb-5 rounded-4 shadow-sm">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold mb-3">
          <i class="bi bi-mortarboard-fill me-1"></i> University Freelance Ecosystem
        </span>
        <h1 class="hero-title mb-3">
          Empowering University Talent. <br>
          <span class="hero-gradient-text">Commission Real Projects.</span>
        </h1>
        <p class="hero-subtitle mb-4">
          SkillBridge is the premier campus-driven freelance marketplace connecting capable university students with clients, faculty research labs, and startups.
        </p>

        <!-- Prominent Search Bar Form -->
        <form action="/marketplace" method="GET" class="p-2 bg-white rounded-pill shadow-sm border d-flex gap-2 mb-4" style="max-width: 580px;">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted ps-3">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" name="q" class="form-control border-0 shadow-none ps-2" placeholder="Search web dev, Figma, Python, content writing..." aria-label="Search services">
          </div>
          <button type="submit" class="btn btn-primary-custom rounded-pill px-4">Search</button>
        </form>

        <!-- Quick Tags -->
        <div class="d-flex flex-wrap align-items-center gap-2 small text-muted">
          <span class="fw-semibold">Popular Skills:</span>
          <a href="/marketplace?q=Node.js" class="badge-skill text-decoration-none">Node.js</a>
          <a href="/marketplace?q=Figma" class="badge-skill text-decoration-none">Figma UI/UX</a>
          <a href="/marketplace?q=Python" class="badge-skill text-decoration-none">Python</a>
          <a href="/marketplace?q=React" class="badge-skill text-decoration-none">React</a>
        </div>
      </div>

      <!-- Hero Visual Stats Card -->
      <div class="col-lg-5">
        <div class="passport-card p-4">
          <div class="passport-ribbon">VERIFIED</div>
          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="/images/logo.svg" alt="SkillBridge Passport" width="48" height="48" class="rounded">
            <div>
              <h5 class="fw-bold mb-0">Student Skill Passport</h5>
              <small class="text-muted">Academic Credential & Project Trust</small>
            </div>
          </div>
          <div class="p-3 bg-light rounded-3 mb-3 border">
            <div class="row text-center g-2">
              <div class="col-4 border-end">
                <div class="fs-4 fw-bold text-primary"><%= stats.totalStudents %></div>
                <div class="small text-muted" style="font-size: 0.75rem;">Verified Students</div>
              </div>
              <div class="col-4 border-end">
                <div class="fs-4 fw-bold text-success"><%= stats.completedOrders %></div>
                <div class="small text-muted" style="font-size: 0.75rem;">Completed Projects</div>
              </div>
              <div class="col-4">
                <div class="fs-4 fw-bold text-warning"><%= stats.platformAvgRating %> <i class="bi bi-star-fill fs-6"></i></div>
                <div class="small text-muted" style="font-size: 0.75rem;">Client Rating</div>
              </div>
            </div>
          </div>
          <p class="small text-muted mb-0">
            <i class="bi bi-patch-check-fill text-primary me-1"></i> Every review and completed order is backed by genuine MongoDB transaction records. No fake metrics.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Popular Service Categories -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Explore Disciplines</h6>
      <h2 class="fw-bold mb-0">Popular Service Categories</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">View All Categories <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <div class="row g-3">
    <% categories.forEach(category => { %>
      <div class="col-xl-4 col-md-6">
        <a href="/marketplace?category=<%= category.slug %>" class="text-decoration-none text-dark">
          <div class="custom-card p-3 h-100 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-primary-subtle text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
              <i class="bi <%= category.icon %>"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-1"><%= category.name %></h6>
              <p class="text-muted small mb-0 text-truncate" style="max-width: 240px;"><%= category.description %></p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</section>

<!-- Featured Freelance Services -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Handpicked Solutions</h6>
      <h2 class="fw-bold mb-0">Featured Student Services</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">Browse Marketplace <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <div class="row g-4">
    <% featuredServices.forEach(service => { %>
      <div class="col-lg-4 col-md-6">
        <div class="custom-card h-100 d-flex flex-column">
          <img src="<%= service.thumbnailUrl || '/images/default-service.svg' %>" alt="<%= service.title %>" class="service-card-img w-100">
          <div class="p-3 d-flex flex-column flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge bg-light text-secondary border small">
                <i class="bi <%= service.category.icon %> me-1"></i><%= service.category.name %>
              </span>
              <span class="small text-muted">
                <i class="bi bi-clock me-1"></i><%= service.deliveryDays %> Days
              </span>
            </div>

            <h6 class="fw-bold mb-2">
              <a href="/marketplace/<%= service._id %>" class="text-decoration-none text-dark stretched-link">
                <%= service.title %>
              </a>
            </h6>

            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= service.description %>
            </p>

            <!-- Freelancer Info & Price -->
            <div class="pt-3 border-top d-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
              <a href="/freelancers/<%= service.freelancer._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <img src="<%= service.freelancer.profileImage || '/images/default-avatar.svg' %>" alt="<%= service.freelancer.name %>" class="rounded-circle" width="30" height="30" style="object-fit: cover;">
                <span class="small fw-semibold"><%= service.freelancer.name %></span>
                <% if (service.freelancer.isVerified) { %>
                  <i class="bi bi-patch-check-fill text-primary" title="Verified Skill Passport"></i>
                <% } %>
              </a>
              <div class="text-end">
                <span class="text-muted small d-block" style="font-size: 0.7rem;">Starting at</span>
                <span class="fw-bold text-primary fs-6"><%= formatCurrency(service.price) %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- Student Skill Passport Innovation Showcase -->
<section class="container mb-5">
  <div class="card border-0 bg-primary text-white rounded-4 p-4 p-lg-5 shadow-lg position-relative overflow-hidden">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-bold mb-2">DISTINCTIVE INNOVATION</span>
        <h2 class="fw-bold text-white mb-3">The Student Skill Passport</h2>
        <p class="lead opacity-90 mb-4" style="font-size: 1.1rem;">
          Traditional freelance platforms rely on unvetted reviews and generic claims. SkillBridge introduces the <strong>Student Skill Passport</strong>: an academic-backed identity featuring verified college credentials, real order completion history, and rule-based skill match scoring.
        </p>
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="d-flex gap-2 align-items-start">
              <i class="bi bi-shield-fill-check fs-4 text-warning"></i>
              <div>
                <h6 class="fw-bold mb-1">Admin Verification</h6>
                <p class="small opacity-75 mb-0">Identity verified by university administrators.</p>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex gap-2 align-items-start">
              <i class="bi bi-cpu-fill fs-4 text-info"></i>
              <div>
                <h6 class="fw-bold mb-1">Rule-Based Matching</h6>
                <p class="small opacity-75 mb-0">Algorithmic alignment with client skill requirements.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-5 text-center text-lg-end">
        <a href="/marketplace" class="btn btn-light btn-lg px-4 fw-bold text-primary rounded-pill shadow">
          Explore Student Passports <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- How It Works Section -->
<section class="container mb-5 py-3">
  <div class="text-center mb-5">
    <h6 class="text-primary fw-bold text-uppercase small mb-1">Simple Workflow</h6>
    <h2 class="fw-bold">How SkillBridge Works</h2>
    <p class="text-muted">A clear, transparent lifecycle from project initiation to final delivery.</p>
  </div>

  <div class="row g-4 text-center">
    <div class="col-md-3">
      <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
        <div class="rounded-circle bg-primary-subtle text-primary mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
          <i class="bi bi-search"></i>
        </div>
        <h5 class="fw-bold mb-2">1. Discover</h5>
        <p class="text-muted small mb-0">Search services, inspect student portfolios, and evaluate rule-based skill match scores.</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
        <div class="rounded-circle bg-info-subtle text-info mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
          <i class="bi bi-send-check"></i>
        </div>
        <h5 class="fw-bold mb-2">2. Commission</h5>
        <p class="text-muted small mb-0">Submit your project requirements and target deadline. The student reviews and accepts.</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
        <div class="rounded-circle bg-warning-subtle text-warning mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
          <i class="bi bi-kanban"></i>
        </div>
        <h5 class="fw-bold mb-2">3. Track & Deliver</h5>
        <p class="text-muted small mb-0">Follow real-time milestone progression from Accepted to In Progress and Delivered work.</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
        <div class="rounded-circle bg-success-subtle text-success mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
          <i class="bi bi-star"></i>
        </div>
        <h5 class="fw-bold mb-2">4. Complete & Review</h5>
        <p class="text-muted small mb-0">Approve final deliverables and submit verified ratings that enhance the student's Passport.</p>
      </div>
    </div>
  </div>
</section>

<!-- Frequently Asked Questions (FAQ) -->
<section class="container mb-5">
  <div class="text-center mb-4">
    <h6 class="text-primary fw-bold text-uppercase small mb-1">Common Questions</h6>
    <h2 class="fw-bold">Frequently Asked Questions</h2>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="accordion shadow-sm" id="faqAccordion">
        <div class="accordion-item border-0 mb-2 rounded-3 overflow-hidden border">
          <h2 class="accordion-header" id="faqHeading1">
            <button class="accordion-button fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="false" aria-controls="faqCollapse1">
              Who can offer freelance services on SkillBridge?
            </button>
          </h2>
          <div id="faqCollapse1" class="accordion-collapse collapse" aria-labelledby="faqHeading1" data-bs-parent="#faqAccordion">
            <div class="accordion-body text-muted small">
              Enrolled university students with verifiable skills in software development, design, content writing, AI, and tutoring can register as Student Freelancers. Their profiles can be verified by university administrators.
            </div>
          </div>
        </div>

        <div class="accordion-item border-0 mb-2 rounded-3 overflow-hidden border">
          <h2 class="accordion-header" id="faqHeading2">
            <button class="accordion-button fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">
              How does the Student Skill Passport calculate metrics?
            </button>
          </h2>
          <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faqAccordion">
            <div class="accordion-body text-muted small">
              The metrics displayed on every student profile are dynamically calculated from real database orders and verified client reviews. Completed order counts and star ratings are mathematically aggregated using MongoDB queries.
            </div>
          </div>
        </div>

        <div class="accordion-item border-0 mb-2 rounded-3 overflow-hidden border">
          <h2 class="accordion-header" id="faqHeading3">
            <button class="accordion-button fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">
              How are client reviews protected from manipulation?
            </button>
          </h2>
          <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faqAccordion">
            <div class="accordion-body text-muted small">
              Only a client who commissioned an order and marked it as Completed can submit a review. The MongoDB schema enforces a unique index on the Order reference, guaranteeing that each order receives at most one genuine review.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
