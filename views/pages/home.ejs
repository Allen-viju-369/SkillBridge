<!-- Hero Section -->
<section class="hero-section text-center text-lg-start mb-5 rounded-4 shadow-sm">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="badge hero-badge px-3 py-2 rounded-pill fw-semibold mb-3 d-inline-flex align-items-center gap-2">
          <span class="pulse-dot"></span> University Freelance Ecosystem
        </span>
        <h1 class="hero-title mb-3">
          Empowering University Talent. <br>
          <span class="hero-gradient-text">Commission Real Projects.</span>
        </h1>
        <p class="hero-subtitle mb-4">
          SkillBridge is the premier campus-driven freelance marketplace connecting capable university students with clients, faculty research labs, and startups.
        </p>

        <!-- Prominent Elevated Search Bar Form -->
        <form action="/marketplace" method="GET" class="hero-search-box d-flex align-items-center gap-2 mb-4">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted p-0">
              <i class="bi bi-search fs-5 text-primary"></i>
            </span>
            <input type="text" name="q" class="form-control border-0 shadow-none ps-3 fs-6" placeholder="Search web dev, Figma, Python, content writing..." aria-label="Search services">
          </div>
          <button type="submit" class="btn btn-primary-custom rounded-pill px-4 text-nowrap fw-bold">
            <i class="bi bi-search me-1"></i>Search
          </button>
        </form>

        <!-- Interactive Quick Tags -->
        <div class="d-flex flex-wrap align-items-center gap-2 small text-muted">
          <span class="fw-bold text-dark me-1">Popular Skills:</span>
          <a href="/marketplace?q=Node.js" class="badge-skill-tag"><i class="bi bi-tag-fill text-primary small"></i> Node.js</a>
          <a href="/marketplace?q=Figma" class="badge-skill-tag"><i class="bi bi-tag-fill text-danger small"></i> Figma UI/UX</a>
          <a href="/marketplace?q=Python" class="badge-skill-tag"><i class="bi bi-tag-fill text-success small"></i> Python</a>
          <a href="/marketplace?q=React" class="badge-skill-tag"><i class="bi bi-tag-fill text-info small"></i> React</a>
        </div>
      </div>

      <!-- Hero Visual Stats Card -->
      <div class="col-lg-5">
        <div class="passport-card p-4">
          <div class="passport-ribbon">VERIFIED</div>
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="passport-hero-icon">
              <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-dark">Student Skill Passport</h5>
              <small class="text-muted fw-medium">Academic Credential & Project Trust</small>
            </div>
          </div>
          <div class="p-3 bg-white bg-opacity-75 rounded-4 mb-3 border shadow-sm">
            <div class="row text-center g-2">
              <div class="col-4">
                <div class="stat-pill-students">
                  <div class="fs-4 fw-bold"><%= stats.totalStudents || 0 %></div>
                  <div class="fw-bold" style="font-size: 0.72rem; letter-spacing: 0.3px;">STUDENTS</div>
                </div>
              </div>
              <div class="col-4">
                <div class="stat-pill-projects">
                  <div class="fs-4 fw-bold"><%= stats.completedOrders || 0 %></div>
                  <div class="fw-bold" style="font-size: 0.72rem; letter-spacing: 0.3px;">PROJECTS</div>
                </div>
              </div>
              <div class="col-4">
                <div class="stat-pill-rating">
                  <div class="fs-4 fw-bold"><%= stats.platformAvgRating || '0.0' %> <i class="bi bi-star-fill fs-6"></i></div>
                  <div class="fw-bold" style="font-size: 0.72rem; letter-spacing: 0.3px;">RATING</div>
                </div>
              </div>
            </div>
          </div>
          <p class="small text-muted mb-0 lh-sm">
            <i class="bi bi-patch-check-fill text-primary me-1"></i> Every review and completed order is backed by genuine MongoDB transaction records. No fake metrics.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Popular Service Categories -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Explore Disciplines</h6>
      <h2 class="fw-bold mb-0">Popular Service Categories</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">View All Categories <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <% if (categories && categories.length > 0) { %>
    <%
      const catClassMap = {
        'web-development': 'cat-web',
        'ui-ux-design': 'cat-design',
        'mobile-app-development': 'cat-mobile',
        'ai-data-python': 'cat-ai',
        'content-writing': 'cat-writing',
        'academic-tutoring': 'cat-tutor'
      };
    %>
    <div class="row g-3">
      <% categories.forEach(category => { %>
        <% const themeClass = catClassMap[category.slug] || 'cat-web'; %>
        <div class="col-xl-4 col-md-6">
          <a href="/marketplace?category=<%= category.slug %>" class="category-card">
            <div class="cat-icon-container <%= themeClass %>">
              <i class="bi <%= category.icon %>"></i>
            </div>
            <div class="flex-grow-1 min-w-0">
              <h6 class="fw-bold mb-1 text-dark"><%= category.name %></h6>
              <p class="text-muted small mb-0 text-truncate" style="max-width: 200px;"><%= category.description %></p>
            </div>
            <div class="cat-arrow">
              <i class="bi bi-chevron-right"></i>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-4 bg-white rounded-4 border">
      <i class="bi bi-tags fs-2 text-muted mb-2 d-block"></i>
      <p class="text-muted small mb-0">No categories found yet.</p>
    </div>
  <% } %>
</section>

<!-- Featured Freelance Services -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Handpicked Solutions</h6>
      <h2 class="fw-bold mb-0">Featured Student Services</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">Browse Marketplace <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <% if (featuredServices && featuredServices.length > 0) { %>
    <div class="row g-4">
      <% featuredServices.forEach(service => { %>
        <div class="col-lg-4 col-md-6">
          <div class="custom-card position-relative h-100 d-flex flex-column">
            <img src="<%= service.thumbnailUrl || '/images/default-service.svg' %>" alt="<%= service.title %>" class="service-card-img w-100" loading="lazy" onerror="this.onerror=null;this.src='/images/default-service.svg';">
            <div class="p-3 d-flex flex-column flex-grow-1">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-secondary border small">
                  <i class="bi <%= service.category ? service.category.icon : 'bi-briefcase' %> me-1"></i><%= service.category ? service.category.name : 'Service' %>
                </span>
                <span class="small text-muted">
                  <i class="bi bi-clock me-1"></i><%= service.deliveryDays %> Days
                </span>
              </div>

              <h6 class="fw-bold mb-2">
                <a href="/marketplace/<%= service._id %>" class="text-decoration-none text-dark stretched-link">
                  <%= service.title %>
                </a>
              </h6>

              <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= service.description %>
              </p>

              <!-- Freelancer Info & Price -->
              <div class="pt-3 border-top d-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
                <% if (service.freelancer) { %>
                  <a href="/freelancers/<%= service.freelancer._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                    <img src="<%= service.freelancer.profileImage || '/images/default-avatar.svg' %>" alt="<%= service.freelancer.name %>" class="rounded-circle" width="30" height="30" style="object-fit: cover;">
                    <span class="small fw-semibold"><%= service.freelancer.name %></span>
                    <% if (service.freelancer.isVerified) { %>
                      <i class="bi bi-patch-check-fill text-primary" title="Verified Skill Passport"></i>
                    <% } %>
                  </a>
                <% } else { %>
                  <span class="small text-muted">Student Freelancer</span>
                <% } %>
                <div class="text-end">
                  <span class="text-muted small d-block" style="font-size: 0.7rem;">Starting at</span>
                  <span class="fw-bold text-primary fs-6"><%= formatCurrency(service.price) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
      <i class="bi bi-briefcase fs-1 text-muted mb-3 d-block"></i>
      <h5 class="fw-bold mb-1">No services yet. Be the first to post one!</h5>
      <p class="text-muted small mb-3">Join as a student freelancer and publish your freelance packages to get hired.</p>
      <% if (isStudent) { %>
        <a href="/services/create" class="btn btn-primary-custom btn-sm"><i class="bi bi-plus-lg me-1"></i>Post a Service</a>
      <% } else { %>
        <a href="/auth/register?role=student" class="btn btn-primary-custom btn-sm"><i class="bi bi-person-plus me-1"></i>Become a Student Freelancer</a>
      <% } %>
    </div>
  <% } %>
</section>

<!-- Featured Student Freelancers Section -->
<section class="container mb-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h6 class="text-primary fw-bold text-uppercase small mb-1">Campus Creators</h6>
      <h2 class="fw-bold mb-0">Featured Student Freelancers</h2>
    </div>
    <a href="/marketplace" class="btn btn-outline-custom btn-sm">Discover All <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <% if (topFreelancers && topFreelancers.length > 0) { %>
    <div class="row g-4">
      <% topFreelancers.forEach(fl => { %>
        <div class="col-md-6 col-lg-3">
          <div class="custom-card p-3 h-100 text-center d-flex flex-column align-items-center">
            <img src="<%= fl.profileImage || '/images/default-avatar.svg' %>" alt="<%= fl.name %>" class="rounded-circle mb-2" width="64" height="64" style="object-fit: cover;">
            <h6 class="fw-bold mb-0">
              <%= fl.name %>
              <% if (fl.isVerified) { %><i class="bi bi-patch-check-fill text-primary" title="Verified"></i><% } %>
            </h6>
            <small class="text-muted mb-2 d-block text-truncate" style="max-width: 180px;"><%= fl.college || 'Student Freelancer' %></small>
            <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
              <% (fl.skills || []).slice(0, 3).forEach(s => { %>
                <span class="badge-skill" style="font-size: 0.7rem;"><%= s %></span>
              <% }) %>
            </div>
            <a href="/freelancers/<%= fl._id %>" class="btn btn-outline-custom btn-sm mt-auto w-100">View Skill Passport</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-4 bg-white rounded-4 border">
      <i class="bi bi-people fs-2 text-muted mb-2 d-block"></i>
      <h6 class="fw-bold mb-1">No student freelancers registered yet.</h6>
      <p class="text-muted small mb-3">Be the first to build your Student Skill Passport and showcase your talent.</p>
      <a href="/auth/register?role=student" class="btn btn-primary-custom btn-sm"><i class="bi bi-person-plus me-1"></i>Register as Student Freelancer</a>
    </div>
  <% } %>
</section>

<!-- Student Skill Passport Innovation Showcase -->
