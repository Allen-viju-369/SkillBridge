<div class="container mb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="fw-bold mb-1">Client Project Hub</h1>
      <p class="text-muted small mb-0">Track commissioned student projects, review deliverables, and post verified ratings.</p>
    </div>
    <div>
      <a href="/marketplace" class="btn btn-primary-custom btn-sm">
        <i class="bi bi-search me-1"></i>Explore Services to Hire
      </a>
    </div>
  </div>

  <!-- Client Summary Stats -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="p-3 bg-white rounded-4 border shadow-sm">
        <span class="text-muted small fw-semibold">Total Capital Invested</span>
        <div class="fs-3 fw-bold text-primary mt-1"><%= formatCurrency(totalSpent) %></div>
        <small class="text-muted" style="font-size: 0.72rem;">On completed student freelance work</small>
      </div>
    </div>
    <div class="col-md-4">
      <div class="p-3 bg-white rounded-4 border shadow-sm">
        <span class="text-muted small fw-semibold">Active Commissions</span>
        <div class="fs-3 fw-bold text-warning mt-1"><%= activeOrders.length %></div>
        <small class="text-muted" style="font-size: 0.72rem;">Currently pending, in-progress, or delivered</small>
      </div>
    </div>
    <div class="col-md-4">
      <div class="p-3 bg-white rounded-4 border shadow-sm">
        <span class="text-muted small fw-semibold">Completed Projects</span>
        <div class="fs-3 fw-bold text-success mt-1"><%= completedOrders.length %></div>
        <small class="text-muted" style="font-size: 0.72rem;">Successfully delivered & approved</small>
      </div>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="card border-0 rounded-4 shadow-sm overflow-hidden border">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0">Commissioned Orders (<%= orders.length %>)</h5>
    </div>

    <% if (orders && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small">
            <tr>
              <th>Order ID</th>
              <th>Service</th>
              <th>Student Freelancer</th>
              <th>Price</th>
              <th>Deadline</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(ord => { %>
              <tr>
                <td class="small font-monospace text-muted">
                  #<%= ord._id.toString().substring(18) %>
                </td>
                <td class="small fw-semibold">
                  <%= ord.service ? ord.service.title : 'Service Package' %>
                </td>
                <td>
                  <a href="/freelancers/<%= ord.freelancer._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                    <img src="<%= ord.freelancer.profileImage || '/images/default-avatar.svg' %>" alt="<%= ord.freelancer.name %>" class="rounded-circle" width="28" height="28">
                    <span class="small fw-semibold"><%= ord.freelancer.name %></span>
                    <% if (ord.freelancer.isVerified) { %>
                      <i class="bi bi-patch-check-fill text-primary" title="Verified Skill Passport"></i>
                    <% } %>
                  </a>
                </td>
                <td class="small fw-bold text-primary">
                  <%= formatCurrency(ord.price) %>
                </td>
                <td class="small text-muted">
                  <%= formatDate(ord.deadline) %>
                </td>
                <td>
                  <% 
                    let badgeClass = 'bg-secondary';
                    if (ord.status === 'pending') badgeClass = 'bg-warning text-dark';
                    if (ord.status === 'accepted') badgeClass = 'bg-info text-dark';
                    if (ord.status === 'in_progress') badgeClass = 'bg-primary';
                    if (ord.status === 'delivered') badgeClass = 'bg-info';
                    if (ord.status === 'completed') badgeClass = 'bg-success';
                    if (ord.status === 'rejected' || ord.status === 'cancelled') badgeClass = 'bg-danger';
                  %>
                  <span class="badge <%= badgeClass %> text-uppercase small">
                    <%= ord.status.replace('_', ' ') %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <a href="/orders/<%= ord._id %>" class="btn btn-sm btn-light border py-1 px-2">
                      Details
                    </a>

                    <% if (ord.status === 'delivered') { %>
                      <!-- Approve Delivery Button -->
                      <form action="/orders/<%= ord._id %>/status" method="POST" class="d-inline" onsubmit="return confirm('Confirm delivery approval and mark project completed?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="targetStatus" value="completed">
                        <button type="submit" class="btn btn-sm btn-success py-1 px-2">
                          <i class="bi bi-check2-circle me-1"></i>Approve & Complete
                        </button>
                      </form>
                    <% } %>

                    <% if (ord.status === 'completed' && !ord.hasReview) { %>
                      <a href="/orders/<%= ord._id %>/review" class="btn btn-sm btn-warning text-dark py-1 px-2">
                        <i class="bi bi-star-fill me-1"></i>Rate & Review
                      </a>
                    <% } %>

                    <% if (ord.status === 'pending') { %>
                      <form action="/orders/<%= ord._id %>/status" method="POST" class="d-inline" onsubmit="return confirm('Cancel this pending request?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="targetStatus" value="cancelled">
                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2">
                          Cancel
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 bg-white">
        <i class="bi bi-briefcase fs-1 text-muted mb-3 d-block"></i>
        <h5 class="fw-bold mb-1">No Orders Yet</h5>
        <p class="text-muted small mb-3">You haven't commissioned any student freelance work yet.</p>
        <a href="/marketplace" class="btn btn-primary-custom btn-sm">Explore Student Marketplace</a>
      </div>
    <% } %>
  </div>
</div>
