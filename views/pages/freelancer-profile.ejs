<div class="container mb-5">
  <!-- Skill Passport Header Hero -->
  <div class="passport-card p-4 p-md-5 mb-4">
    <% if (passport.freelancer.isVerified) { %>
      <div class="passport-ribbon">VERIFIED PASSPORT</div>
    <% } %>

    <div class="row align-items-center g-4">
      <div class="col-md-auto text-center">
        <img src="<%= passport.freelancer.profileImage || '/images/default-avatar.svg' %>" alt="<%= passport.freelancer.name %>" class="rounded-circle shadow-sm border border-4 border-white" width="120" height="120" style="object-fit: cover;">
      </div>

      <div class="col-md">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <h2 class="fw-bold mb-0"><%= passport.freelancer.name %></h2>
          <% if (passport.freelancer.isVerified) { %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small">
              <i class="bi bi-patch-check-fill me-1"></i>University Verified Freelancer
            </span>
          <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary border small">
              <i class="bi bi-hourglass-split me-1"></i>Verification Pending
            </span>
          <% } %>
        </div>

        <p class="text-secondary mb-2">
          <i class="bi bi-mortarboard me-1 text-primary"></i>
          <strong><%= passport.freelancer.degree || 'Degree Program' %></strong> &bull; <%= passport.freelancer.yearOfStudy || 'Enrolled Student' %> &bull; <%= passport.freelancer.college || 'University' %>
        </p>

        <p class="text-muted small mb-3" style="max-width: 700px;">
          <%= passport.freelancer.bio || 'Dedicated student freelancer showcasing projects, verified credentials, and client satisfaction on SkillBridge.' %>
        </p>

        <!-- Skill Tags -->
        <div class="d-flex flex-wrap gap-1">
          <% (passport.freelancer.skills || []).forEach(skill => { %>
            <span class="badge-skill"><i class="bi bi-check2 text-success me-1"></i><%= skill %></span>
          <% }) %>
        </div>
      </div>

      <!-- Verified Dynamic Metrics Box -->
      <div class="col-lg-3 col-md-4">
        <div class="bg-white p-3 rounded-4 border shadow-sm">
          <h6 class="fw-bold text-uppercase small text-muted mb-3 border-bottom pb-2">Verifiable Metrics</h6>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-secondary">Completed Projects:</span>
            <span class="badge bg-success-subtle text-success fs-6 fw-bold">
              <%= passport.metrics.completedProjectsCount %>
            </span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-secondary">Average Rating:</span>
            <span class="badge bg-warning-subtle text-warning-emphasis fs-6 fw-bold">
              <%= passport.metrics.averageRating %> <i class="bi bi-star-fill text-warning"></i>
            </span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="small text-secondary">Total Reviews:</span>
            <span class="badge bg-light text-dark border fw-bold">
              <%= passport.metrics.reviewCount %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Services & Reviews -->
    <div class="col-lg-8">
      <!-- Published Freelance Services -->
      <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Active Service Offerings</h5>
          <span class="badge bg-light text-secondary border"><%= passport.services.length %> Services</span>
        </div>

        <% if (passport.services && passport.services.length > 0) { %>
          <div class="row g-3">
            <% passport.services.forEach(srv => { %>
              <div class="col-md-6">
                <div class="custom-card position-relative p-3 h-100 d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                      <%= srv.category ? srv.category.name : 'Service' %>
                    </span>
                    <span class="small text-muted"><i class="bi bi-clock me-1"></i><%= srv.deliveryDays %>d</span>
                  </div>
                  <h6 class="fw-bold mb-2">
                    <a href="/marketplace/<%= srv._id %>" class="text-decoration-none text-dark stretched-link">
                      <%= srv.title %>
                    </a>
                  </h6>
                  <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= srv.description %>
                  </p>
                  <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Starting at</span>
                    <span class="fw-bold text-primary"><%= formatCurrency(srv.price) %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">This student freelancer currently has no active service listings.</p>
        <% } %>
      </div>

      <!-- Client Reviews & Ratings Breakdown -->
      <div class="bg-white p-4 rounded-4 border shadow-sm">
        <h5 class="fw-bold mb-3">Client Feedback & Ratings</h5>

        <% if (passport.reviews && passport.reviews.length > 0) { %>
          <div class="row align-items-center g-3 mb-4 p-3 bg-light rounded-3 border">
            <div class="col-sm-4 text-center border-end">
              <div class="display-5 fw-bold text-dark"><%= passport.metrics.averageRating %></div>
              <div class="text-warning mb-1">
                <%- renderStars(passport.metrics.averageRating) %>
              </div>
              <div class="small text-muted"><%= passport.metrics.reviewCount %> Verified Client <%= passport.metrics.reviewCount === 1 ? 'Review' : 'Reviews' %></div>
            </div>
            <div class="col-sm-8">
              <% [5, 4, 3, 2, 1].forEach(star => { %>
                <% 
                  const count = passport.metrics.ratingDistribution[star] || 0;
                  const pct = passport.metrics.reviewCount > 0 ? (count / passport.metrics.reviewCount) * 100 : 0;
                %>
                <div class="d-flex align-items-center gap-2 small mb-1">
                  <span style="width: 45px;"><%= star %> <i class="bi bi-star-fill text-warning"></i></span>
                  <div class="progress flex-grow-1" style="height: 6px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: <%= pct %>%;"></div>
                  </div>
                  <span class="text-muted" style="width: 25px;"><%= count %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Reviews List -->
          <div class="d-flex flex-column gap-3">
            <% passport.reviews.forEach(review => { %>
              <div class="p-3 rounded-3 border bg-white">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div class="d-flex align-items-center gap-2">
                    <img src="<%= review.client ? review.client.profileImage : '/images/default-avatar.svg' %>" alt="Client" class="rounded-circle" width="36" height="36" style="object-fit: cover;">
                    <div>
                      <h6 class="fw-bold mb-0"><%= review.client ? review.client.name : 'Verified Client' %></h6>
                      <small class="text-muted"><%= formatDate(review.createdAt) %></small>
                    </div>
                  </div>
                  <div class="text-warning small">
                    <%- renderStars(review.rating) %>
                  </div>
                </div>
                <% if (review.service) { %>
                  <div class="small text-muted mb-2">
                    <i class="bi bi-check-circle-fill text-success me-1"></i>Project: <strong><%= review.service.title %></strong>
                  </div>
                <% } %>
                <p class="text-secondary small mb-0">
                  "<%= review.comment %>"
                </p>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-chat-square-text fs-2 d-block mb-2"></i>
            <p class="small mb-0">No client reviews yet. Reviews unlock automatically upon completion of verified orders.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Portfolios & Rule-based Matcher -->
    <div class="col-lg-4">
      <!-- Portfolio Links Showcase -->
      <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
        <h6 class="fw-bold mb-3"><i class="bi bi-folder-check text-primary me-2"></i>Portfolio Artifacts</h6>
        <% if (passport.freelancer.portfolioLinks && passport.freelancer.portfolioLinks.length > 0) { %>
          <div class="d-flex flex-column gap-2">
            <% passport.freelancer.portfolioLinks.forEach(item => { %>
              <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="p-3 rounded-3 border text-decoration-none text-dark bg-light d-flex align-items-center justify-content-between">
                <div>
                  <div class="fw-bold small"><%= item.title %></div>
                  <% if (item.description) { %>
                    <small class="text-muted text-truncate d-block" style="max-width: 200px;"><%= item.description %></small>
                  <% } %>
                </div>
                <i class="bi bi-box-arrow-up-right text-primary"></i>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">No external portfolio links provided yet.</p>
        <% } %>
      </div>

      <!-- Skill Match Test Form -->
      <div class="bg-white p-4 rounded-4 border shadow-sm">
        <h6 class="fw-bold mb-2"><i class="bi bi-sliders text-primary me-2"></i>Skill Match Test</h6>
        <p class="small text-muted mb-3">
          Simulate rule-based skill overlap for your required tech stack:
        </p>

        <form action="/freelancers/<%= passport.freelancer._id %>" method="GET" class="mb-3">
          <div class="input-group input-group-sm mb-2">
            <input type="text" name="skills" class="form-control" placeholder="e.g. Node.js, Python, CSS" value="<%= customMatch ? customMatch.matchedSkills.concat(customMatch.missingSkills).join(', ') : '' %>">
            <button type="submit" class="btn btn-primary-custom btn-sm">Match</button>
          </div>
        </form>

        <% if (customMatch) { %>
          <div class="p-3 bg-light rounded-3 border">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="small fw-bold">Compatibility:</span>
              <span class="fw-bold text-<%= customMatch.matchPercentage >= 70 ? 'success' : 'warning' %>">
                <%= customMatch.matchPercentage %>%
              </span>
            </div>
            <div class="progress mb-2" style="height: 6px;">
              <div class="progress-bar bg-<%= customMatch.matchPercentage >= 70 ? 'success' : 'warning' %>" role="progressbar" style="width: <%= customMatch.matchPercentage %>%;"></div>
            </div>
            <div class="small">
              <span class="text-success fw-bold">Matched:</span>
              <% if (customMatch.matchedSkills.length > 0) { %>
                <%= customMatch.matchedSkills.join(', ') %>
              <% } else { %>
                <span class="text-muted">None</span>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
