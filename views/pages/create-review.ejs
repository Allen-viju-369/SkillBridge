<div class="container py-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
        <div class="text-center mb-4">
          <div class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px; font-size: 1.6rem;">
            <i class="bi bi-star-fill"></i>
          </div>
          <h3 class="fw-bold mb-1">Rate & Review Project</h3>
          <p class="text-muted small">Your review will be permanently attached to the student's Skill Passport.</p>
        </div>

        <!-- Project Overview Box -->
        <div class="p-3 bg-light rounded-3 border mb-4">
          <div class="d-flex align-items-center gap-3">
            <img src="<%= order.freelancer.profileImage || '/images/default-avatar.svg' %>" alt="Freelancer" class="rounded-circle" width="45" height="45">
            <div>
              <div class="fw-bold"><%= order.freelancer.name %></div>
              <small class="text-muted d-block"><%= order.service ? order.service.title : 'Commissioned Project' %></small>
            </div>
          </div>
        </div>

        <form action="/orders/<%= order._id %>/review" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Rating Stars Selector -->
          <div class="mb-4 text-center">
            <label class="form-label fw-bold small text-secondary d-block mb-2">Overall Experience Rating</label>
            <div class="d-flex justify-content-center gap-2">
              <% [1, 2, 3, 4, 5].forEach(star => { %>
                <input type="radio" class="btn-check" name="rating" id="star<%= star %>" value="<%= star %>" <%= star === 5 ? 'checked' : '' %> required>
                <label class="btn btn-outline-warning text-dark px-3 py-2 rounded-3 d-flex flex-column align-items-center" for="star<%= star %>">
                  <i class="bi bi-star-fill text-warning fs-5"></i>
                  <span class="small fw-bold"><%= star %></span>
                </label>
              <% }) %>
            </div>
            <div class="form-text small mt-2">1 = Poor, 5 = Exceptional Work</div>
          </div>

          <!-- Review Comment -->
          <div class="mb-4">
            <label for="reviewComment" class="form-label fw-semibold small text-secondary">
              Detailed Written Feedback <span class="text-danger">*</span>
            </label>
            <textarea name="comment" id="reviewComment" class="form-control" rows="4" placeholder="Share specific details about code quality, responsiveness, delivery speed, and overall satisfaction (at least 5 characters)..." minlength="5" maxlength="1000" required></textarea>
            <div class="invalid-feedback">Please provide at least 5 characters of feedback.</div>
          </div>

          <div class="d-flex gap-2">
            <a href="/orders/<%= order._id %>" class="btn btn-light border w-50">Cancel</a>
            <button type="submit" class="btn btn-primary-custom w-50">
              <i class="bi bi-check-lg me-1"></i>Publish Review
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
