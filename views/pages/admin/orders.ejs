<div class="container mb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/admin">Admin Hub</a></li>
          <li class="breadcrumb-item active" aria-current="page">Orders Oversight</li>
        </ol>
      </nav>
      <h2 class="fw-bold mb-0">Platform Orders Oversight</h2>
      <p class="text-muted small mb-0">Audit project progression, monitor disputes, and verify delivery milestones.</p>
    </div>
    <a href="/admin" class="btn btn-outline-custom btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back to Hub
    </a>
  </div>

  <div class="card border-0 rounded-4 shadow-sm border overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th>Order ID</th>
            <th>Service</th>
            <th>Client</th>
            <th>Freelancer</th>
            <th>Price</th>
            <th>Status</th>
            <th>Commissioned</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(ord => { %>
            <tr>
              <td class="small font-monospace text-muted">#<%= ord._id.toString().substring(18) %></td>
              <td class="small fw-semibold"><%= ord.service ? ord.service.title : 'Service' %></td>
              <td class="small"><%= ord.client ? ord.client.name : 'Client' %></td>
              <td class="small">
                <%= ord.freelancer ? ord.freelancer.name : 'Freelancer' %>
                <% if (ord.freelancer && ord.freelancer.isVerified) { %>
                  <i class="bi bi-patch-check-fill text-primary" title="Verified"></i>
                <% } %>
              </td>
              <td class="small fw-bold text-primary"><%= formatCurrency(ord.price) %></td>
              <td>
                <span class="badge bg-<%= ord.status === 'completed' ? 'success' : ord.status === 'pending' ? 'warning' : ord.status === 'delivered' ? 'info' : 'primary' %> text-uppercase small">
                  <%= ord.status.replace('_', ' ') %>
                </span>
              </td>
              <td class="small text-muted"><%= formatDate(ord.createdAt) %></td>
              <td class="text-end">
                <a href="/orders/<%= ord._id %>" class="btn btn-sm btn-light border py-1 px-2">
                  Inspect Order
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
