<div class="container mb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/admin">Admin Hub</a></li>
          <li class="breadcrumb-item active" aria-current="page">User Directory</li>
        </ol>
      </nav>
      <h2 class="fw-bold mb-0">Platform User Directory</h2>
      <p class="text-muted small mb-0">Manage accounts, suspend violators, and verify student credentials for the Skill Passport.</p>
    </div>
    <a href="/admin" class="btn btn-outline-custom btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back to Hub
    </a>
  </div>

  <!-- Role Filters -->
  <div class="card border-0 rounded-4 shadow-sm border mb-4">
    <div class="card-body p-3 d-flex flex-wrap gap-2 align-items-center">
      <span class="small fw-bold text-muted me-2">Filter Role:</span>
      <a href="/admin/users" class="btn btn-sm <%= !query.role || query.role === 'all' ? 'btn-primary-custom' : 'btn-light border' %>">All Users</a>
      <a href="/admin/users?role=student" class="btn btn-sm <%= query.role === 'student' ? 'btn-primary-custom' : 'btn-light border' %>">Students</a>
      <a href="/admin/users?role=client" class="btn btn-sm <%= query.role === 'client' ? 'btn-primary-custom' : 'btn-light border' %>">Clients</a>
      <a href="/admin/users?role=admin" class="btn btn-sm <%= query.role === 'admin' ? 'btn-primary-custom' : 'btn-light border' %>">Admins</a>
    </div>
  </div>

  <!-- Users Table -->
  <div class="card border-0 rounded-4 shadow-sm border overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th>User</th>
            <th>Role</th>
            <th>College / Affiliation</th>
            <th>Passport Verification</th>
            <th>Account Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <img src="<%= u.profileImage || '/images/default-avatar.svg' %>" alt="" class="rounded-circle" width="36" height="36" style="object-fit: cover;">
                  <div>
                    <div class="fw-semibold small"><%= u.name %></div>
                    <small class="text-muted"><%= u.email %></small>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge bg-<%= u.role === 'admin' ? 'danger' : u.role === 'student' ? 'primary' : 'info' %>-subtle text-<%= u.role === 'admin' ? 'danger' : u.role === 'student' ? 'primary' : 'info' %> border">
                  <%= u.role.toUpperCase() %>
                </span>
              </td>
              <td class="small text-muted">
                <%= u.college || 'N/A' %>
              </td>
              <td>
                <% if (u.role === 'student') { %>
                  <% if (u.isVerified) { %>
                    <span class="badge bg-success-subtle text-success border">
                      <i class="bi bi-patch-check-fill me-1"></i>Verified Badge
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border">
                      Unverified
                    </span>
                  <% } %>
                <% } else { %>
                  <span class="text-muted small">&mdash;</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-<%= u.accountStatus === 'active' ? 'success' : 'danger' %>">
                  <%= u.accountStatus.toUpperCase() %>
                </span>
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <!-- Verification Toggle for Students -->
                  <% if (u.role === 'student') { %>
                    <form action="/admin/users/<%= u._id %>/toggle-verify" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-<%= u.isVerified ? 'secondary' : 'success' %> py-1 px-2" title="Toggle Skill Passport Verification">
                        <i class="bi <%= u.isVerified ? 'bi-patch-minus' : 'bi-patch-check' %> me-1"></i>
                        <%= u.isVerified ? 'Revoke' : 'Verify' %>
                      </button>
                    </form>
                    <a href="/freelancers/<%= u._id %>" class="btn btn-sm btn-light border py-1 px-2" title="View Skill Passport">
                      <i class="bi bi-eye"></i>
                    </a>
                  <% } %>

                  <!-- Account Status Toggle (Active vs Suspended) -->
                  <% if (u._id.toString() !== currentUser._id) { %>
                    <form action="/admin/users/<%= u._id %>/toggle-status" method="POST" class="d-inline" onsubmit="return confirm('Change account status for <%= u.name %>?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-<%= u.accountStatus === 'active' ? 'danger' : 'success' %> py-1 px-2">
                        <%= u.accountStatus === 'active' ? 'Suspend' : 'Activate' %>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
