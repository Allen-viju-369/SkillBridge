<div class="container mb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/admin">Admin Hub</a></li>
          <li class="breadcrumb-item active" aria-current="page">Service Moderation</li>
        </ol>
      </nav>
      <h2 class="fw-bold mb-0">Service Listings Moderation</h2>
      <p class="text-muted small mb-0">Review published freelance packages and toggle marketplace visibility.</p>
    </div>
    <a href="/admin" class="btn btn-outline-custom btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back to Hub
    </a>
  </div>

  <div class="card border-0 rounded-4 shadow-sm border overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th>Service Title</th>
            <th>Category</th>
            <th>Freelancer</th>
            <th>Price</th>
            <th>Delivery</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% services.forEach(srv => { %>
            <tr>
              <td class="small fw-semibold">
                <a href="/marketplace/<%= srv._id %>" class="text-decoration-none text-dark">
                  <%= srv.title %>
                </a>
              </td>
              <td>
                <span class="badge bg-light text-secondary border small">
                  <%= srv.category ? srv.category.name : 'Uncategorized' %>
                </span>
              </td>
              <td class="small">
                <%= srv.freelancer ? srv.freelancer.name : 'N/A' %>
                <% if (srv.freelancer && srv.freelancer.isVerified) { %>
                  <i class="bi bi-patch-check-fill text-primary" title="Verified Freelancer"></i>
                <% } %>
              </td>
              <td class="small fw-bold text-primary"><%= formatCurrency(srv.price) %></td>
              <td class="small text-muted"><%= srv.deliveryDays %> Days</td>
              <td>
                <span class="badge bg-<%= srv.isActive ? 'success' : 'secondary' %>">
                  <%= srv.isActive ? 'Active' : 'Hidden / Inactive' %>
                </span>
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <a href="/marketplace/<%= srv._id %>" class="btn btn-sm btn-light border py-1 px-2" title="Inspect">
                    <i class="bi bi-eye"></i>
                  </a>
                  <form action="/admin/services/<%= srv._id %>/toggle" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-<%= srv.isActive ? 'danger' : 'success' %> py-1 px-2">
                      <%= srv.isActive ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
