<header>
  <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
    <div class="container">
      <!-- Brand Logo & Title -->
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <div class="brand-logo-icon shadow-sm rounded-3 overflow-hidden d-flex">
          <svg width="34" height="34" viewBox="0 0 48 48" fill="none">
            <rect width="48" height="48" rx="12" fill="url(#navSbGrad)" />
            <path d="M10 34 C18 24, 30 24, 38 34" stroke="url(#navSbAccent)" stroke-width="3.5" stroke-linecap="round" fill="none" />
            <path d="M24 14 L36 20 L24 26 L12 20 Z" fill="#FFFFFF" />
            <path d="M18 23.5 V29 C18 31.5, 30 31.5, 30 29 V23.5" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" fill="none" />
            <circle cx="36" cy="20" r="2.5" fill="#F59E0B" />
            <defs>
              <linearGradient id="navSbGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4F46E5" />
                <stop offset="100%" stop-color="#7C3AED" />
              </linearGradient>
              <linearGradient id="navSbAccent" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#06B6D4" />
                <stop offset="100%" stop-color="#3B82F6" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="d-flex flex-column">
          <span class="fw-bold text-dark lh-1" style="font-size: 1.25rem;">SkillBridge</span>
          <span class="text-muted fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.3px;">FREELANCE STUDENT MARKETPLACE</span>
        </div>
      </a>

      <!-- Mobile Toggle Button -->
      <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Nav Links -->
      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
              <i class="bi bi-house-door me-1"></i>Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/marketplace') ? 'active' : '' %>" href="/marketplace">
              <i class="bi bi-grid me-1"></i>Explore Services
            </a>
          </li>

          <% if (isLoggedIn) { %>
            <% if (isStudent) { %>
              <li class="nav-item">
                <a class="nav-link <%= currentPath.startsWith('/dashboard/freelancer') ? 'active' : '' %>" href="/dashboard/freelancer">
                  <i class="bi bi-speedometer2 me-1"></i>Freelancer Dashboard
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-primary fw-semibold" href="/services/create">
                  <i class="bi bi-plus-circle me-1"></i>Post Service
                </a>
              </li>
            <% } else if (isClient) { %>
              <li class="nav-item">
                <a class="nav-link <%= currentPath.startsWith('/dashboard/client') ? 'active' : '' %>" href="/dashboard/client">
                  <i class="bi bi-kanban me-1"></i>My Projects
                </a>
              </li>
            <% } else if (isAdmin) { %>
              <li class="nav-item">
                <a class="nav-link <%= currentPath.startsWith('/admin') ? 'active' : '' %> text-danger fw-semibold" href="/admin">
                  <i class="bi bi-shield-check me-1"></i>Admin Hub
                </a>
              </li>
            <% } %>
          <% } %>
        </ul>

        <!-- Right User Actions -->
        <div class="d-flex align-items-center gap-2">
          <% if (isLoggedIn) { %>
            <div class="dropdown">
              <button class="btn btn-light d-flex align-items-center gap-2 border py-1 px-3 rounded-pill dropdown-toggle shadow-sm" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="background: rgba(255, 255, 255, 0.9);">
                <span class="user-avatar-badge" style="background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%); width: 30px; height: 30px; font-size: 0.85rem;"><%= (currentUser.name || 'U').charAt(0).toUpperCase() %></span>
                <span class="fw-semibold text-truncate" style="max-width: 140px;"><%= currentUser.name %></span>
                <span class="badge bg-secondary-subtle text-secondary border rounded-pill" style="font-size: 0.7rem;">
                  <%= currentUser.role.toUpperCase() %>
                </span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 mt-2" aria-labelledby="userMenuButton">
                <li class="px-3 py-1 text-muted" style="font-size: 0.8rem;">
                  Signed in as <strong><%= currentUser.email %></strong>
                </li>
                <li><hr class="dropdown-divider"></li>
                <% if (isStudent) { %>
                  <li><a class="dropdown-item" href="/dashboard/freelancer"><i class="bi bi-speedometer2 me-2 text-primary"></i>My Dashboard</a></li>
                  <li><a class="dropdown-item" href="/freelancers/<%= currentUser._id %>"><i class="bi bi-award me-2 text-success"></i>My Skill Passport</a></li>
                  <li><a class="dropdown-item" href="/services/create"><i class="bi bi-plus-square me-2 text-info"></i>Create Service</a></li>
                <% } else if (isClient) { %>
                  <li><a class="dropdown-item" href="/dashboard/client"><i class="bi bi-kanban me-2 text-primary"></i>Project Orders</a></li>
                <% } else if (isAdmin) { %>
                  <li><a class="dropdown-item" href="/admin"><i class="bi bi-shield-lock me-2 text-danger"></i>Admin Dashboard</a></li>
                  <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>Manage Users</a></li>
                  <li><a class="dropdown-item" href="/admin/services"><i class="bi bi-card-checklist me-2"></i>Service Moderation</a></li>
                  <li><a class="dropdown-item" href="/admin/categories"><i class="bi bi-tags me-2"></i>Categories</a></li>
                <% } %>
                <li><a class="dropdown-item" href="/profile/edit"><i class="bi bi-person-gear me-2 text-secondary"></i>Edit Profile</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form action="/auth/logout" method="POST" class="d-inline w-100">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="dropdown-item text-danger">
                      <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                    </button>
                  </form>
                </li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/login" class="btn btn-outline-custom">Log In</a>
            <a href="/auth/register" class="btn btn-primary-custom">Get Started</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
